# Local virtual environment.
.venv/
# Python bytecode caches.
__pycache__/
# Editable-install build metadata.
*.egg-info/
# Local secrets such as ANTHROPIC_API_KEY.
.env
# Local quote cache (regenerated by runs).
quote_cache.json
# Local actual-vs-estimated cost log (grows with each run).
run_log.jsonl
# Local registry of discovered suppliers (grows with each discovery).
supplier_candidates.json
# Personal preferences and source-review acknowledgments.
memory.json
# Local command-outcome history.
events.jsonl
# Personal preference writer lock.
memory.lock
